# Copy to keystore.properties (same folder). That file is git-ignored. NEVER commit the keystore or its passwords,
# and keep a backup of the keystore: if you lose it you can no longer update the app on Google Play (unless you use Play App Signing recovery).
#
# Create a keystore once (answer the prompts, choose strong passwords):
#   keytool -genkeypair -v -keystore arrowflow-release.jks -alias arrowflow -keyalg RSA -keysize 4096 -validity 10000
storeFile=arrowflow-release.jks
storePassword=
keyAlias=arrowflow
keyPassword=
